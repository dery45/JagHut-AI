# ─────────────────────────────────────────────
# Jaghut v0.1L — Environment Configuration
# ESG & Sustainability Intelligence Platform
# ─────────────────────────────────────────────

# ── API Keys ──────────────────────────────────
PERENUAL_API_KEY=""

# ── Database ──────────────────────────────────
PORT=3000
MONGO_URI=""

# ── ChromaDB ──────────────────────────────────
CHROMA_HOST=
CHROMA_PORT=

# ── Ollama Models ─────────────────────────────
EMBED_MODEL=mxbai-embed-large
LLM_MODEL=jaghut-v0.1L
UTILITY_MODEL=qwen2.5:1.5b

# ── Telegram Bot ──────────────────────────────
TELEGRAM_BOT_TOKEN=""
# Kosongkan = semua user bisa akses debug
# Isi user_id (pisahkan koma) untuk restrict: DEBUG_ALLOWED_USERS=123456,789012
DEBUG_ALLOWED_USERS=

# ── Word Config paths ─────────────────────────
SCOPE_CONFIG_PATH=config/settings/scope_config.ini
REWRITER_CONFIG_PATH=config/settings/rewriter_config.ini
ENTITY_CONFIG_PATH=config/settings/esg_entities.ini

# ── App Config ────────────────────────────────
MEMORY_TTL_DAYS=14
BM25_CACHE_PATH=data/db/bm25_cache.pkl

# ── Weather / Climate (Open-Meteo) ────────────
LATITUDE=-6.1818
LONGITUDE=106.8223
LOCATION_NAME=Jakarta, Indonesia
PAST_DAYS=92
FORECAST_DAYS=16
CHECK_INTERVAL=300
